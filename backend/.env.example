DATABASE_URL=postgresql://username:password@localhost:5432/tts_study_assistant
# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Set only behind a reverse proxy, e.g. X-Forwarded-For
PROXY_HEADER=
# Optional: enables note summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
