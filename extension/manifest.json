{
    "manifest_version": 3,
    "name": "TTS Study Assistant",
    "version": "0.3.3",
    "description": "Save and listen to text from any webpage",
    "minimum_chrome_version": "121",
    "permissions": [
        "storage",
        "tts",
        "activeTab",
        "scripting",
        "contextMenus",
        "notifications"
    ],
    "host_permissions": [
        "https://tts-study-assistant-production.up.railway.app/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ],
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles/content.css"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "64": "icons/icon-64.png",
            "96": "icons/icon-96.png",
            "128": "icons/icon-128.png",
            "256": "icons/icon-256.png",
            "512": "icons/icon-512.png"
        }
    },
    "commands": {
        "save-selection": {
            "suggested_key": {
                "default": "Alt+Shift+Y",
                "mac": "Alt+Shift+Y"
            },
            "description": "Save selected text as note"
        },
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+S",
                "mac": "Alt+Shift+S"
            }
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "tts-study-assistant@pratts.github.io",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "websiteContent",
                    "browsingActivity",
                    "authenticationInfo",
                    "personallyIdentifyingInfo"
                ]
            }
        }
    }
}
